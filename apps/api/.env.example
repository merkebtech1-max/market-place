NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/merkeb_market"

# SMS / OTP
SMS_PROVIDER=console             # console | afromessage
# Set SMS_PROVIDER=afromessage and supply credentials in your local .env to send real SMS.
AFROMESSAGE_TOKEN=your_api_token
AFROMESSAGE_IDENTIFIER_ID=your_identifier_id
AFROMESSAGE_SENDER_NAMES=Merkeb
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
OTP_IP_RATE_LIMIT=5
IP_HASH_SECRET=replace_with_another_long_random_secret

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# QR token signing secret
QR_TOKEN_SECRET=<replace-with-a-long-random-secret>

# Object storage (Cloudflare R2)
R2_ENDPOINT=your_r2_endpoint_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
